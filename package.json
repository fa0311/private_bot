{
  "name": "private_bot",
  "version": "1.0.0",
  "description": "Next generation bot using @line/bot-sdk and discord.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:snap": "tsx watch src/snap.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:snap": "node dist/snap.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "biome check src",
    "lint:fix": "biome check --fix src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.3.0",
    "async-mutex": "^0.5.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "twitter-openapi-typescript": "^0.0.57",
    "twitter-openapi-typescript-generated": "^0.0.41",
    "webdav": "^5.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typed-emitter": "^2.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "bot",
    "line",
    "discord",
    "typescript",
    "esm"
  ],
  "author": "yuki",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
